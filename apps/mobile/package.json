{
  "name": "@novo/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:apk": "powershell -ExecutionPolicy Bypass -File ../../scripts/build-apk.ps1",
    "build:apk:development": "powershell -ExecutionPolicy Bypass -File ../../scripts/build-apk.ps1 -Environment Development -Platform Android",
    "build:apk:beta": "powershell -ExecutionPolicy Bypass -File ../../scripts/build-apk.ps1 -Environment Beta -Platform Android",
    "build:apk:production": "powershell -ExecutionPolicy Bypass -File ../../scripts/build-apk.ps1 -Environment Production -Platform Android",
    "build:mobile": "powershell -ExecutionPolicy Bypass -File ../../scripts/build-mobile.ps1",
    "build:mobile:development": "powershell -ExecutionPolicy Bypass -File ../../scripts/build-mobile.ps1 -Environment Development",
    "build:mobile:beta": "powershell -ExecutionPolicy Bypass -File ../../scripts/build-mobile.ps1 -Environment Beta",
    "build:mobile:production": "powershell -ExecutionPolicy Bypass -File ../../scripts/build-mobile.ps1 -Environment Production",
    "build:android:development": "powershell -ExecutionPolicy Bypass -File ../../scripts/build-apk.ps1 -Environment Development -Platform Android",
    "build:ios:development": "powershell -ExecutionPolicy Bypass -File ../../scripts/build-apk.ps1 -Environment Development -Platform iOS",
    "build:android:beta": "powershell -ExecutionPolicy Bypass -File ../../scripts/build-apk.ps1 -Environment Beta -Platform Android",
    "build:ios:beta": "powershell -ExecutionPolicy Bypass -File ../../scripts/build-apk.ps1 -Environment Beta -Platform iOS",
    "build:android:production": "powershell -ExecutionPolicy Bypass -File ../../scripts/build-apk.ps1 -Environment Production -Platform Android",
    "build:ios:production": "powershell -ExecutionPolicy Bypass -File ../../scripts/build-apk.ps1 -Environment Production -Platform iOS",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-three/fiber": "^9.8.1",
    "expo": "~57.0.25",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-auth-session": "~57.0.13",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~58.0.3",
    "expo-constants": "~58.0.7",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-gl": "~57.0.2",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-nfc-manager": "^3.17.2",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "5.10.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "~0.21.3",
    "react-native-webview": "14.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/three": "^0.170.0",
    "typescript": "^5.7.3"
  }
}

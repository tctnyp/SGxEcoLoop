{
  "expo": {
    "name": "novo",
    "slug": "novo",
    "scheme": "novo",
    "version": "1.1.20",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8F8EF",
    "splash": {
      "image": "./assets/icon.png",
      "backgroundColor": "#17352A",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "28",
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.novo.ecoloop",
      "associatedDomains": [
        "applinks:novo.tancheetiong.com",
        "applinks:novodev.tancheetiong.com"
      ]
    },
    "android": {
      "package": "com.novo.ecoloop",
      "versionCode": 28,
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17352A"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            { "scheme": "https", "host": "novo.tancheetiong.com", "pathPrefix": "/invite/" },
            { "scheme": "https", "host": "novodev.tancheetiong.com", "pathPrefix": "/invite/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow novo to photograph task evidence and scan in-app reward codes."
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow novo to show your location and nearby community events on the Tasks map."
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "novo only uses photos captured inside the app for task evidence.",
          "cameraPermission": "Allow novo to photograph evidence for your custom task."
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Allow novo to pair and interact with your wristband.",
          "includeNdefEntitlement": false
        }
      ],
      "./plugins/withAndroidCleartext",
      "./plugins/withAndroidVersion",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 31
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "name": "novo",
      "favicon": "./assets/icon.png"
    }
  }
}

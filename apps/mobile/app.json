{
  "expo": {
    "name": "novo",
    "slug": "novo",
    "scheme": "novo",
    "version": "1.0.5",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8F8EF",
    "splash": {
      "image": "./assets/icon.png",
      "backgroundColor": "#17352A",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.novo.ecoloop"
    },
    "android": {
      "package": "com.novo.ecoloop",
      "versionCode": 7,
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17352A"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Novo to scan the QR code on your plushie accessory."
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow novo to show your location and nearby community events on the Tasks map."
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow novo to attach evidence to your custom task.",
          "cameraPermission": "Allow novo to photograph evidence for your custom task."
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Allow novo to pair and interact with your plushie."
        }
      ],
      "./plugins/withAndroidCleartext",
      "./plugins/withAndroidVersion",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 31
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "name": "novo",
      "favicon": "./assets/icon.png"
    }
  }
}
